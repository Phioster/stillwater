[gd_resource type="Resource" script_class="FishData" format=3]

[ext_resource type="Script" path="res://resources/catch_condition.gd" id="1_cond"]
[ext_resource type="Script" path="res://resources/fish_data.gd" id="2_fish"]
[ext_resource type="Script" path="res://resources/level_condition.gd" id="3_lvl"]
[ext_resource type="Script" path="res://resources/time_of_day_condition.gd" id="4_extra"]

[sub_resource type="Resource" id="Resource_lvl"]
script = ExtResource("3_lvl")
min_level = 14

[sub_resource type="Resource" id="Resource_extra"]
script = ExtResource("4_extra")
from_hour = 22
to_hour = 4
window_name = "tief in der Nacht"

[resource]
script = ExtResource("2_fish")
id = &"hour_wisp"
display_name = "Stundenlicht"
zone_id = &"night_moor"
rarity_id = &"epic"
base_value = 560
strength = 200.0
difficulty = 2.4
xp = 290
weight_mean = 2.0
weight_dev = 0.6
is_secret = true
secret_chance = 0.03
secret_hint = "Nur wenn es draußen wirklich Nacht ist, steht ein Licht über dem Moor."
conditions = Array[ExtResource("1_cond")]([SubResource("Resource_lvl"), SubResource("Resource_extra")])
